specification {
  element deploymentActor {
    style {
      shape person
    }
  }
  element deploymentSystem
  element deploymentComponent
}

model {
  customerCustomer = deploymentActor 'Customer' {
    description 'The regular customer of the system'
  }

  deploymentSass = deploymentSystem 'Our SaaS' {
    component ui 'Frontend' {
      description 'Nextjs application, hosted on Vercel'
      style {
        icon tech:nextjs
        shape browser
      }
    }
    deploymentComponent backend 'Backend Services' {
      description '
        Implements business logic
        and exposes as REST API
      '
      -> db 'reads/writes'
    }

    db = component 'Database' {
      icon tech:postgresql
      style {
        shape storage
      }
    }

    // UI requests data from the Backend
    ui -> backend 'fetches via HTTPS'
  }



  // Customer uses the UI
  customer -> ui 'opens in browser'
  customer -> saas 'enjoys our product'
}

views {

  view overview {
    title 'Landscape view'

    include *
  }

  view saas of saas {
    include *

    style * {
      opacity 25%
    }
    style customer {
      color muted
    }
  }

}

